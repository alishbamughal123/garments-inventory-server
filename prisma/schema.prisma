generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phoneNumber  String?  @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions            InventoryTransaction[]
  purchaseBatches         PurchaseBatch[]
  returns                 Return[]

  leadsAssigned           Lead[]                  @relation("LeadAssignedTo")
  leadsCreated            Lead[]                  @relation("LeadCreatedBy")
  tasksAssigned           Task[]                  @relation("TaskAssignedUser")
  tasksCreated            Task[]                  @relation("TaskCreatedBy")
  remindersCreated        Reminder[]              @relation("ReminderCreatedBy")
  taskAssignmentsPerformed TaskAssignmentHistory[] @relation("TaskAssignmentPerformedBy")
  previousTaskAssignments TaskAssignmentHistory[] @relation("TaskPreviousAssignedUser")
  newTaskAssignments     TaskAssignmentHistory[] @relation("TaskNewAssignedUser")
  crmActivities           Activity[]              @relation("ActivityCreatedBy")
  emailConversationsCreated EmailConversation[]   @relation("EmailConversationCreatedBy")
  emailMessagesCreated    EmailMessage[]          @relation("EmailMessageCreatedBy")

  ticketsCreated          SupportTicket[]         @relation("TicketCreatedBy")
  ticketsAssigned         SupportTicket[]         @relation("TicketAssignedTo")
  priceHistories          PriceHistory[]          @relation("PriceChangedBy")
  customerOrdersFulfilled CustomerOrder[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Supplier {
  id              String          @id @default(uuid())
  supplierName    String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseBatches PurchaseBatch[]
}

model Product {
  id                String                 @id @default(uuid())
  sku               String                 @unique
  productName       String
  baseStyleNumber   String?
  styleNumber       String?                @unique
  styleName         String?
  itemName          String?
  brand             String?
  color             String
  colorCode         String?
  size              String?
  fabric            String?
  fabricComposition String?
  fabricWeight      String?
  weightInKg        Float                  @default(0.0)
  purchasePrice     Decimal                @db.Decimal(10, 2)
  salePrice         Decimal                @db.Decimal(10, 2)
  stockQuantity     Int                    @default(0)
  minStockAlert     Int                    @default(5)
  imageUrl          String?
  washingInstructionsImageUrl String?
  washingInstructions String?
  isContracted      Boolean                @default(false)
  logoOptions       Json?
  sizeChart         Json?
  sizeChartMeasurements Json?
  description       String?
  isActive          Boolean                @default(true)
  categoryId        String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  barcodes          Barcode[]
  transactions      InventoryTransaction[]
  category          Category               @relation(fields: [categoryId], references: [id])
  returns           Return[]
  saleItems         SaleItem[]
  priceHistories    PriceHistory[]
  customPrices      CustomerPrice[]
  customerAccess    CustomerProductAccess[]
  orderItems        CustomerOrderItem[]

  @@index([sku])
  @@index([baseStyleNumber])
  @@index([styleNumber])
  @@index([styleName])
  @@index([productName])
}

model SizeChart {
  id               String   @id @default(uuid())
  styleNumber      String   @unique
  title            String?
  applicableStyles Json?
  sizes            Json
  measurements     Json
  unit             String   @default("cm")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([styleNumber])
}

model Barcode {
  id            String        @id @default(uuid())
  barcodeValue  String        @unique
  barcodeType   BarcodeType
  barcodeSource BarcodeSource
  isPrimary     Boolean       @default(false)
  productId     String
  createdAt     DateTime      @default(now())
  product       Product       @relation(fields: [productId], references: [id])

  @@index([barcodeValue])
}

model PurchaseBatch {
  id            String   @id @default(uuid())
  batchNumber   String   @unique
  invoiceNumber String?
  totalItems    Int      @default(0)
  notes         String?
  supplierId    String
  receivedById  String?
  receivedDate  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  receivedBy    User?    @relation(fields: [receivedById], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])
}

model InventoryTransaction {
  id                String          @id @default(uuid())
  transactionType   TransactionType
  quantity          Int
  previousStock     Int
  newStock          Int
  referenceNumber   String?
  notes             String?
  productId         String
  performedById     String
  customerId        String?
  packagingWeightKg Float?          @default(0.2)
  totalWeightKg     Float?
  createdAt         DateTime        @default(now())

  performedBy       User            @relation(fields: [performedById], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryNote      DeliveryNote?

  @@index([transactionType])
  @@index([createdAt])
  @@index([customerId])
}

model Return {
  id              String   @id @default(uuid())
  returnQuantity  Int
  returnReason    String?
  conditionStatus String?
  productId       String
  processedById   String
  createdAt       DateTime @default(now())
  processedBy     User     @relation(fields: [processedById], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
}

model Customer {
  id             String         @id @default(uuid())
  customerCode   String?        @unique
  fullName       String
  companyName    String?
  designation    String?
  phoneNumber    String         @unique
  alternatePhone String?
  email          String?        @unique
  passwordHash   String?
  isPortalActive Boolean        @default(true)
  vatNumber      String?
  address        String?
  city           String?
  website        String?
  source         String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  customerType   CustomerType   @default(REGULAR)
  totalOrders    Int            @default(0)
  totalSpent     Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sales              Sale[]
  interactions       CustomerInteraction[]
  tasks              Task[]
  activities         Activity[]              @relation("CustomerActivities")
  emailConversations EmailConversation[]
  emailMessages      EmailMessage[]
  supportTickets     SupportTicket[]
  contacts           CustomerContact[]
  customPrices       CustomerPrice[]
  productAccess      CustomerProductAccess[]
  customerOrders     CustomerOrder[]
  stockOuts          InventoryTransaction[]
  deliveryNotes      DeliveryNote[]

  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerPrice {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  customPrice Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model CustomerProductAccess {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model CustomerOrder {
  id                String              @id @default(uuid())
  orderNumber       String              @unique
  customerId        String
  status            CustomerOrderStatus @default(PENDING)
  subtotal          Decimal             @db.Decimal(10, 2)
  tax               Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal             @db.Decimal(10, 2)
  garmentWeightKg   Float               @default(0)
  packagingWeightKg Float               @default(0.2)
  totalParcelWeight Float               @default(0.2)
  notes             String?
  shippingAddress   String?
  fulfilledAt       DateTime?
  fulfilledById     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id])
  fulfilledBy  User?               @relation(fields: [fulfilledById], references: [id])
  orderItems   CustomerOrderItem[]
  deliveryNote DeliveryNote?

  @@index([customerId])
  @@index([status])
}

model CustomerOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal       @db.Decimal(10, 2)
  unitWeight  Float         @default(0)
  totalPrice  Decimal       @db.Decimal(10, 2)
  totalWeight Float         @default(0)
  selectedLogo String?
  customNote  String?

  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

model DeliveryNote {
  id                 String                @id @default(uuid())
  deliveryNoteNumber String                @unique
  customerId         String
  orderId            String?               @unique
  transactionId      String?               @unique
  garmentWeightKg    Float                 @default(0)
  packagingWeightKg  Float                 @default(0.2)
  totalParcelWeight  Float                 @default(0.2)
  notes              String?
  createdAt          DateTime              @default(now())

  customer    Customer              @relation(fields: [customerId], references: [id])
  order       CustomerOrder?        @relation(fields: [orderId], references: [id])
  transaction InventoryTransaction? @relation(fields: [transactionId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity      String
  entityId    String?
  performedBy String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  subject      String
  description  String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([assignedToId])
}

enum CustomerOrderStatus {
  PENDING
  APPROVED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model CustomerInteraction {
  id String @id @default(uuid())

  customerId String

  type InteractionType

  subject String

  description String?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum InteractionType {
  CALL
  MEETING
  NOTE
  FOLLOW_UP
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  STAFF
  CUSTOMER
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  RETURN
  EXCHANGE
  ADJUSTMENT
  DAMAGE
}

enum BarcodeType {
  EAN13
  EAN8
  UPC
  CODE128
  CODE39
  QR_CODE
  CUSTOM
}

enum BarcodeSource {
  SUPPLIER
  GENERATED
  MANUAL
}

enum CustomerType {
  REGULAR
  WHOLESALE
  VIP
}

model Sale {
  id String @id @default(uuid())

  invoiceNumber String @unique

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id])

  subtotal Float

  discount Float @default(0)

  tax Float @default(0)

  grandTotal Float

  paymentMethod String

  createdAt DateTime @default(now())

  saleItems SaleItem[]

  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid())

  saleId String

  sale Sale @relation(fields: [saleId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])

  quantity Int

  price Float

  total Float

  @@map("sale_items")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  REFERRAL
  WALK_IN
  TRADE_SHOW
  EXISTING_CUSTOMER
  OTHER
}

model Lead {
  id String @id @default(uuid())

  fullName    String
  companyName String?
  designation String?

  email       String?
  phoneNumber String

  alternatePhone String?

  address String?
  city    String?

  website String?

  source LeadSource
  status LeadStatus @default(NEW)

  expectedDealValue Float @default(0)

  rank               Int?
  legalEntity        String?
  segment            String?
  priority           String?
  contactType        String?
  verificationStatus String?
  revenueMnok        Float?
  financialYear      String?
  revenueBasis       String?
  county             String?
  relevantStaff      String?
  relevantTextiles   String?
  healthcareNvk      String?

  notes String?

  assignedToId String?
  createdById  String

  assignedTo User? @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  createdBy User @relation("LeadCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities        LeadActivity[]
  assignmentHistory LeadAssignmentHistory[]
  stageHistory      LeadStageHistory[]
  tasks             Task[]
  crmActivities     Activity[] @relation("LeadActivities")
  emailConversations EmailConversation[]
  emailMessages      EmailMessage[]
}

model LeadActivity {
  id String @id @default(uuid())

  leadId String

  activityType String
  subject      String
  description  String?

  createdById String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadAssignmentHistory {
  id String @id @default(uuid())

  leadId String

  previousOwnerId String?
  newOwnerId      String

  assignedById String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadStageHistory {
  id String @id @default(uuid())

  leadId String

  previousStage LeadStatus?
  newStage      LeadStatus

  changedById String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  dueDate        DateTime
  completedAt    DateTime?
  assignedUserId String?
  customerId     String?
  leadId         String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedUser      User?                   @relation("TaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  customer          Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead              Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy         User                    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  reminders         Reminder[]
  assignmentHistory TaskAssignmentHistory[]
  activities        Activity[]             @relation("TaskActivities")

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedUserId])
  @@index([customerId])
  @@index([leadId])
  @@index([createdAt])
}

model Reminder {
  id             String                 @id @default(uuid())
  reminderDate   DateTime
  reminderTime   String
  scheduledFor   DateTime
  note           String?
  channel        ReminderChannel
  recipientType  ReminderRecipientType
  recipientEmail String?
  recipientPhone String?
  deliveryStatus ReminderDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  lastAttemptAt  DateTime?
  failureReason  String?
  taskId         String
  createdById    String
  createdAt      DateTime               @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User @relation("ReminderCreatedBy", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([reminderDate])
  @@index([scheduledFor])
  @@index([deliveryStatus])
}

model TaskAssignmentHistory {
  id                     String   @id @default(uuid())
  taskId                 String
  previousAssignedUserId String?
  newAssignedUserId      String?
  assignedById           String
  note                   String?
  createdAt              DateTime @default(now())

  task                 Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousAssignedUser User? @relation("TaskPreviousAssignedUser", fields: [previousAssignedUserId], references: [id], onDelete: SetNull)
  newAssignedUser      User? @relation("TaskNewAssignedUser", fields: [newAssignedUserId], references: [id], onDelete: SetNull)
  assignedBy           User  @relation("TaskAssignmentPerformedBy", fields: [assignedById], references: [id])

  @@index([taskId])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType
  subject        String
  description    String?
  startsAt       DateTime?
  endsAt         DateTime?
  customerId     String?
  leadId         String?
  taskId         String?
  emailMessageId String?
  createdById    String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer     Customer?     @relation("CustomerActivities", fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation("LeadActivities", fields: [leadId], references: [id], onDelete: SetNull)
  task         Task?         @relation("TaskActivities", fields: [taskId], references: [id], onDelete: SetNull)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([leadId])
  @@index([taskId])
  @@index([type])
  @@index([createdAt])
}

model EmailConversation {
  id           String   @id @default(uuid())
  subject      String
  threadKey    String   @unique
  customerId   String?
  leadId       String?
  createdById  String
  lastMessageAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User      @relation("EmailConversationCreatedBy", fields: [createdById], references: [id])
  messages  EmailMessage[]

  @@index([customerId])
  @@index([leadId])
  @@index([lastMessageAt])
}

model EmailMessage {
  id                String         @id @default(uuid())
  conversationId    String
  customerId        String?
  leadId            String?
  createdById       String
  direction         EmailDirection
  status            EmailStatus    @default(PENDING)
  fromName          String?
  fromEmail         String
  toEmail           String
  cc                String?
  bcc               String?
  subject           String
  bodyHtml          String?
  bodyText          String?
  providerMessageId String?        @unique
  trackingToken     String?        @unique
  sentAt            DateTime?
  openedAt          DateTime?
  repliedAt         DateTime?
  receivedAt        DateTime?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  conversation EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("EmailMessageCreatedBy", fields: [createdById], references: [id])
  activities   Activity[]

  @@index([conversationId])
  @@index([customerId])
  @@index([leadId])
  @@index([direction])
  @@index([status])
  @@index([trackingToken])
  @@index([createdAt])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  FOLLOW_UP
  APPOINTMENT
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailStatus {
  DRAFT
  PENDING
  SENT
  OPENED
  REPLIED
  FAILED
  RECEIVED
}

enum ReminderChannel {
  EMAIL
  SMS
  EMAIL_AND_SMS
}

enum ReminderRecipientType {
  ASSIGNED_USER
  CUSTOMER
  LEAD
  CUSTOM
}

enum ReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  PARTIAL
}

model PriceHistory {
  id               String   @id @default(uuid())
  productId        String
  oldSalePrice     Decimal  @db.Decimal(10, 2)
  newSalePrice     Decimal  @db.Decimal(10, 2)
  oldPurchasePrice Decimal? @db.Decimal(10, 2)
  newPurchasePrice Decimal? @db.Decimal(10, 2)
  reason           String?
  changedById      String?

  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("PriceChangedBy", fields: [changedById], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("price_histories")
}

model PunchOutSession {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  buyerCookie   String
  buyerHookUrl  String
  protocol      String   @default("cXML")
  customerId    String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([customerId])
}

model EhfDocument {
  id              String   @id @default(uuid())
  documentType    String   // ORDER, ORDER_CONFIRMATION, DESPATCH_ADVICE
  direction       String   // INBOUND, OUTBOUND
  status          String   @default("RECEIVED") // RECEIVED, PROCESSED, SENT, FAILED
  payloadXml      String   @db.Text
  orderNumber     String?
  peppolMessageId String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([documentType])
  @@index([orderNumber])
  @@index([createdAt])
}

